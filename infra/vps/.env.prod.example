APP_ENV=production
LOG_LEVEL=INFO
APP_SECRET_KEY=change-this-to-a-long-random-session-secret
SESSION_COOKIE_SECURE=true
PUBLIC_REGISTRATION_ENABLED=false
APP_IMAGE=ghcr.io/YOUR_GITHUB_USER_OR_ORG/jobradar:latest
APP_PORT=8000
APP_MEM_LIMIT=256m
INGEST_MEM_LIMIT=384m

POSTGRES_DB=jobradar
POSTGRES_USER=jobradar
POSTGRES_PASSWORD=change-this-long-random-password
DB_MEM_LIMIT=384m
POSTGRES_SHARED_BUFFERS=96MB
POSTGRES_WORK_MEM=4MB
POSTGRES_MAINTENANCE_WORK_MEM=64MB
POSTGRES_MAX_CONNECTIONS=20

CONFIG_DIR=config
HTTP_TIMEOUT_SECONDS=15
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
MAX_MEM_PERCENT=80
